PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
DB_FILE=./data/sgs-solution.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# First-run admin account (change immediately after setup)
ADMIN_NAME=SGS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Razorpay: leave blank to keep online payments disabled until configured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SGS SOLUTION <notifications@example.com>

# WhatsApp Cloud API (Meta). Use approved templates for production-initiated messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX

# Optional: comma-separated allowed web origins when deploying frontend separately
CORS_ORIGINS=
